{
  "schema_version": "0.1.0",
  "agent": "REPO_STEWARD",
  "mode": "READ_ONLY_CHECKER_WITH_PROPOSAL_ONLY_ADMIN",
  "authorization_boundary": {
    "human_operator_required": true,
    "bot_only_mutation_forbidden": true,
    "delegated_merge_authority_forbidden": true,
    "write_transport_present": false,
    "advisory_lanes": [
      "OPENAI_ASSISTANT",
      "PERPLEXITY",
      "CLAUDE"
    ],
    "rule": "Any future repository mutation requires the human Operator as an explicit authorizing party. Advisory lanes may inspect, recommend, prepare, or independently review, but may not independently authorize or execute repository administration."
  },
  "repositories": [
    {
      "repository": "mirrornode/MIRRORNODE-CORE-HUB",
      "criticality": "constitutional",
      "enabled": true,
      "require_ci": true,
      "require_exact_head_review": true,
      "required_workflows": ["MIRRORNODE Audit", "Canon Gate"],
      "merge_authority": "OPERATOR",
      "admin_actions": ["PROPOSE_FILE", "OPEN_PR", "REQUEST_REVIEW"]
    },
    {
      "repository": "mirrornode/mirrornode-agent-runtime",
      "criticality": "execution",
      "enabled": true,
      "require_ci": true,
      "require_exact_head_review": true,
      "required_workflows": ["PR Validation"],
      "merge_authority": "OPERATOR",
      "admin_actions": ["PROPOSE_FILE", "PROPOSE_WORKFLOW", "OPEN_PR", "REQUEST_REVIEW"]
    },
    {
      "repository": "mirrornode/mirrornode-operator-console",
      "criticality": "operator_surface",
      "enabled": true,
      "require_ci": true,
      "require_exact_head_review": true,
      "required_workflows": ["PR Validation", "Mainline Audit"],
      "merge_authority": "OPERATOR",
      "admin_actions": ["PROPOSE_FILE", "PROPOSE_WORKFLOW", "OPEN_PR", "REQUEST_REVIEW"]
    },
    {
      "repository": "mirrornode/mirrornode-platform",
      "criticality": "customer_production",
      "enabled": true,
      "require_ci": true,
      "require_exact_head_review": false,
      "required_workflows": ["CI", "Canon Gate"],
      "merge_authority": "OPERATOR",
      "admin_actions": ["PROPOSE_FILE", "PROPOSE_WORKFLOW", "OPEN_PR", "REQUEST_REVIEW"]
    },
    {
      "repository": "mirrornode/mirrornode-osiris",
      "criticality": "evidence_processing",
      "enabled": true,
      "require_ci": true,
      "require_exact_head_review": true,
      "required_workflows": ["PR Validation"],
      "merge_authority": "OPERATOR",
      "admin_actions": ["PROPOSE_FILE", "PROPOSE_WORKFLOW", "OPEN_PR", "REQUEST_REVIEW"]
    },
    {
      "repository": "mirrornode/mn-supply-continuity",
      "criticality": "continuity_state",
      "enabled": true,
      "require_ci": true,
      "require_exact_head_review": true,
      "required_workflows": ["PR Validation"],
      "merge_authority": "OPERATOR",
      "admin_actions": ["PROPOSE_FILE", "PROPOSE_WORKFLOW", "OPEN_PR", "REQUEST_REVIEW"]
    },
    {
      "repository": "mirrornode/mirrornode-parallax",
      "criticality": "public_front_of_house",
      "enabled": true,
      "require_ci": true,
      "require_exact_head_review": false,
      "required_workflows": ["Parallax Front-of-House Gate"],
      "merge_authority": "OPERATOR",
      "admin_actions": ["PROPOSE_FILE", "PROPOSE_WORKFLOW", "OPEN_PR", "REQUEST_REVIEW"]
    }
  ],
  "invariants": [
    "Checker is GET-only and cannot mutate GitHub.",
    "Repo Admin v0.1 has no mutation transport and cannot execute proposals.",
    "No component may certify its own repair as merge authority.",
    "A review bound to an ancestor SHA does not clear a changed head.",
    "CI success never implies approval, deployment, or merge authority.",
    "No autonomous agent, bot identity, service account, coding agent, or advisory model may independently administer repositories.",
    "Every future write path must require explicit human Operator authorization and must fail closed if that authorization is absent or unverifiable.",
    "Permission expansion, ruleset mutation, credential changes, direct-default-branch writes, destructive actions, deployment enablement, and merge remain closed to non-Operator authority."
  ]
}
